# ---------------------------------------------------------------------------
# Public site settings (inlined into the browser bundle at build time)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://www.example.com

# External calendar / booking page the customer continues to after the
# enquiry is acknowledged. Leave empty if the booking platform contacts the
# customer itself (e.g. sends a booking link by WhatsApp/email).
NEXT_PUBLIC_BOOKING_URL=

# Contact details. At least one of phone / WhatsApp / email MUST be set before
# launch — it is the fallback shown when an enquiry cannot be submitted.
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_EMAIL=
# WhatsApp number in international format, digits only (e.g. 919876543210)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Google Analytics 4 measurement ID. Analytics only load after visitor consent.
NEXT_PUBLIC_GA_ID=

# ---------------------------------------------------------------------------
# Server-only settings (never exposed to the browser)
# ---------------------------------------------------------------------------
# HTTPS endpoint of the receiving booking/CRM platform.
CONSULTATION_WEBHOOK_URL=
# Optional: sent as "Authorization: Bearer <token>" if the platform requires it.
CONSULTATION_WEBHOOK_BEARER_TOKEN=
# Optional: HMAC-SHA256 signs "<timestamp>.<body>" into X-Trivana-Signature.
CONSULTATION_WEBHOOK_SIGNING_SECRET=
# How a response counts as an acknowledgement:
#   json   — 2xx AND a JSON body with success:true or status:"success" (default)
#   status — any 2xx response (use only for platforms that return no body)
CONSULTATION_WEBHOOK_ACK_MODE=json
CONSULTATION_WEBHOOK_TIMEOUT_MS=10000

# Optional: separate endpoint for /contact form messages. If empty, contact
# messages go to CONSULTATION_WEBHOOK_URL (event "contact.message_submitted").
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_BEARER_TOKEN=
CONTACT_WEBHOOK_SIGNING_SECRET=
CONTACT_WEBHOOK_ACK_MODE=

# ---------------------------------------------------------------------------
# Jewellery store: GoHighLevel products + on-site checkout (Razorpay)
# ---------------------------------------------------------------------------
# GHL → Settings → Private Integrations → create a token with scopes:
#   products.readonly, products/prices.readonly, products/collection.readonly
# Until both are set, the site shows the old catalogue as a PREVIEW and online
# payment is disabled on the live site.
GHL_PRIVATE_TOKEN=
GHL_LOCATION_ID=
# GHL_API_VERSION=2021-07-28

# Razorpay → Account & Settings → API Keys (use rzp_test_… keys while testing)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay → Webhooks → URL https://<your-domain>/api/razorpay/webhook,
# event "payment.captured"; paste the webhook secret here (backup order record)
RAZORPAY_WEBHOOK_SECRET=
# Optional: separate secret for signing pending orders (defaults to RAZORPAY_KEY_SECRET)
ORDER_TOKEN_SECRET=

# Where paid orders are sent (a GHL "Inbound Webhook" workflow trigger works well).
# If empty, orders go to CONSULTATION_WEBHOOK_URL with event "order.paid".
ORDER_WEBHOOK_URL=
ORDER_WEBHOOK_BEARER_TOKEN=
ORDER_WEBHOOK_SIGNING_SECRET=
ORDER_WEBHOOK_ACK_MODE=

# Secret for /api/revalidate (GHL workflow webhook → refresh shop instantly). 16+ random characters.
REVALIDATE_SECRET=

# Cash on Delivery for jewellery (on unless set to "false"). COD orders are recorded
# in GHL (contact + tags "website-order","cod" + order note) or sent to ORDER_WEBHOOK_URL.
NEXT_PUBLIC_ALLOW_COD=true
# Largest order allowed on COD, in rupees (default 25000)
COD_MAX_AMOUNT=25000

# Pipeline/stage for website order cards (optional; default: pipeline named like "Orders", else the first)
GHL_ORDER_PIPELINE_ID=
GHL_ORDER_STAGE_ID=

# Admin panel (/admin) — one admin login. Password 12+ characters; secret 32+ random characters
# (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
